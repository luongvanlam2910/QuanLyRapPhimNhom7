@using DatVeXemPhim.Models.Entities
@model DatVe
@{
    ViewData["Title"] = ViewData["Title"] ?? "Thanh toán - UTC Cinema";
    var veDauTien = Model.Ves != null && Model.Ves.Any() ? Model.Ves[0] : null;
    var lichChieu = veDauTien?.LichChieu;
}
<div style="background:var(--bg-dark);min-height:calc(100vh - 180px);padding:40px 0">
<div class="container" style="max-width:560px">

    <div class="text-center mb-4">
        <div style="width:72px;height:72px;background:rgba(245,197,24,0.15);border:3px solid #f5c518;border-radius:50%;display:flex;align-items:center;justify-content:center;margin:0 auto 16px">
            <i class="fas fa-credit-card" style="font-size:1.8rem;color:#f5c518"></i>
        </div>
        <h1 style="font-size:1.5rem;font-weight:800;color:#fff;margin-bottom:4px">Cổng thanh toán (mô phỏng)</h1>
        <p style="color:#888;font-size:0.85rem">Đây là trang thanh toán giả lập phục vụ demo — không kết nối cổng thanh toán thật.</p>
    </div>

    <div class="card-dark mb-4">
        <div class="d-flex justify-content-between mb-2">
            <span style="color:#888">Mã đặt vé</span>
            <strong>@Model.MaDat</strong>
        </div>
        <div class="d-flex justify-content-between mb-2">
            <span style="color:#888">Phim</span>
            <strong>@lichChieu?.Phim?.TenPhim</strong>
        </div>
        <div class="d-flex justify-content-between mb-2">
            <span style="color:#888">Suất chiếu</span>
            <strong>@(lichChieu?.ThoiGianBatDau.ToString("HH:mm dd/MM/yyyy"))</strong>
        </div>
        <div class="d-flex justify-content-between mb-2">
            <span style="color:#888">Số ghế</span>
            <strong>@Model.Ves.Count</strong>
        </div>
        <div class="d-flex justify-content-between pt-2" style="border-top:1px solid #2a2a2a">
            <span style="color:#888">Tổng tiền</span>
            <strong style="color:#f5c518;font-size:1.2rem">@Model.TongTien.ToString("N0") ₫</strong>
        </div>
        @if (Model.HanThanhToan.HasValue)
        {
            <div class="text-center mt-3" style="color:#ff9800;font-size:0.85rem">
                <i class="fas fa-hourglass-half me-1"></i>Vui lòng thanh toán trước <strong id="hanThanhToan" data-han="@Model.HanThanhToan.Value.ToString("O")"></strong>
            </div>
        }
    </div>

    <form method="post" asp-action="XacNhanThanhToanGateway" asp-route-maDat="@Model.MaDat">
        @Html.AntiForgeryToken()
        <div class="mb-3">
            <label class="form-label-dark">Phương thức thanh toán</label>
            <select name="phuongThucThanhToan" class="form-select-dark form-select">
                <option>Ví điện tử</option>
                <option>Thẻ ngân hàng</option>
                <option>Chuyển khoản</option>
            </select>
        </div>
        <div class="d-grid gap-2">
            <button type="submit" name="thanhCong" value="true" class="btn-cinema" style="justify-content:center;padding:13px">
                <i class="fas fa-check-circle"></i>Thanh toán thành công (demo)
            </button>
            <button type="submit" name="thanhCong" value="false" class="btn-cinema-outline" style="justify-content:center;padding:13px">
                <i class="fas fa-times-circle"></i>Hủy giao dịch
            </button>
        </div>
    </form>
</div>
</div>

@section Scripts {
<script>
    const el = document.getElementById('hanThanhToan');
    if (el) {
        const han = new Date(el.dataset.han);
        el.textContent = han.toLocaleTimeString('vi-VN') + ' ' + han.toLocaleDateString('vi-VN');
    }
</script>
}
