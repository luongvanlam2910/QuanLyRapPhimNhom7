@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignInManager
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] ?? "Admin - UTC Cinema")</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
    @* asp-append-version chống cache: bắt trình duyệt tải lại CSS mới ngay khi file thay đổi. *@
    <link rel="stylesheet" href="~/css/style.css" asp-append-version="true" />
    @await RenderSectionAsync("Head", required: false)
</head>
<body>

@{
    var currentPath = ViewContext.HttpContext.Request.Path.Value ?? "";
    string SidebarClass(string segment, bool exact = false)
    {
        bool isActive = exact ? currentPath.Equals(segment, StringComparison.OrdinalIgnoreCase)
                               : currentPath.Contains(segment, StringComparison.OrdinalIgnoreCase);
        return isActive ? "sidebar-item active" : "sidebar-item";
    }
}

<div class="admin-layout">
    <!-- SIDEBAR -->
    <aside class="admin-sidebar">
        <div class="sidebar-logo">
            <i class="fas fa-film me-2"></i>UTC Admin
        </div>
        <nav class="sidebar-menu">
            @{
                bool laQuanLyTroLen = User.IsInRole("QuanLy") || User.IsInRole("Admin");
            }
            <div class="sidebar-section">Tổng quan</div>
            <a href="/admin" class="@SidebarClass("/admin", exact: true)">
                <i class="fas fa-tachometer-alt"></i> @(laQuanLyTroLen ? "Dashboard" : "Công việc của tôi")
            </a>
            @* Href bên dưới phải khớp CHÍNH XÁC với [Route] của từng controller (PascalCase, không gạch ngang) —
               trước đây dùng kebab-case (vd "/admin/lich-chieu") không khớp route thật ("/Admin/LichChieu"),
               khiến 8/15 mục menu bấm vào bị 404. *@
            @if (laQuanLyTroLen)
            {
            <div class="sidebar-section">Nội dung</div>
                <a href="/Admin/Phim" class="@SidebarClass("/admin/phim")">
                    <i class="fas fa-film"></i> Quản lý phim
                </a>
                <a href="/Admin/LichChieu" class="@SidebarClass("/admin/lichchieu")">
                    <i class="fas fa-calendar-alt"></i> Lịch chiếu
                </a>
                <a href="/Admin/TheLoai" class="@SidebarClass("/admin/theloai")">
                    <i class="fas fa-tags"></i> Thể loại
                </a>
                <a href="/Admin/RapChieu" class="@SidebarClass("/admin/rapchieu")">
                    <i class="fas fa-building"></i> Rạp &amp; Phòng chiếu
                </a>

                <div class="sidebar-section">Khách hàng</div>
                <a href="/Admin/KhachHang" class="@SidebarClass("/admin/khachhang")">
                    <i class="fas fa-users"></i> Khách hàng
                </a>
                <a href="/Admin/NhanVien" class="@SidebarClass("/admin/nhanvien")">
                    <i class="fas fa-user-tie"></i> Nhân viên
                </a>
                @if (User.IsInRole("Admin"))
                {
                    <a href="/Admin/PhongBan" class="@SidebarClass("/admin/phongban")">
                        <i class="fas fa-sitemap"></i> Phòng ban
                    </a>
                }
            }

            <div class="sidebar-section">Vận hành</div>
            <a href="/Admin/BanVe" class="@SidebarClass("/admin/banve")">
                <i class="fas fa-cash-register"></i> Bán vé tại quầy
            </a>
            <a href="/Admin/DatVe" class="@SidebarClass("/admin/datve")">
                <i class="fas fa-ticket-alt"></i> @(laQuanLyTroLen ? "Quản lý đặt vé" : "Vé tôi đã bán")
            </a>
            <a href="/Admin/SoatVe" class="@SidebarClass("/admin/soatve")">
                <i class="fas fa-qrcode"></i> Soát vé
            </a>
            @if (laQuanLyTroLen)
            {
                <a href="/Admin/ThanhToan" class="@SidebarClass("/admin/thanhtoan")">
                    <i class="fas fa-money-bill-wave"></i> Thanh toán
                </a>
                <a href="/Admin/KhuyenMai" class="@SidebarClass("/admin/khuyenmai")">
                    <i class="fas fa-tags"></i> Khuyến mãi
                </a>
                <a href="/Admin/BaoCao" class="@SidebarClass("/admin/baocao")">
                    <i class="fas fa-chart-bar"></i> Báo cáo
                </a>
            }

            <div class="sidebar-section">Tài khoản</div>
            <a href="/" class="sidebar-item">
                <i class="fas fa-home"></i> Về trang chủ
            </a>
            <form action="/Auth/Logout" method="post" style="margin:0">
                @Html.AntiForgeryToken()
                <button type="submit" class="sidebar-item" style="width:100%;background:none;border:none;color:#e50914;cursor:pointer;text-align:left">
                    <i class="fas fa-sign-out-alt"></i> Đăng xuất
                </button>
            </form>
        </nav>
        <div style="padding:16px;border-top:1px solid #2a2a2a;font-size:0.78rem;color:#666">
            <div style="color:#b3b3b3;font-weight:600">@User.Identity?.Name</div>
            <div style="color:#666">@(User.IsInRole("Admin") ? "Quản trị hệ thống" : User.IsInRole("QuanLy") ? "Quản lý rạp" : User.IsInRole("NhanVien") ? "Nhân viên" : "")</div>
        </div>
    </aside>

    <!-- MAIN CONTENT -->
    <main class="admin-content">
        <!-- Flash messages -->
        @{
            var successMessage = TempData["successMessage"] as string;
            var errorMessage = TempData["errorMessage"] as string;
        }
        @if (!string.IsNullOrEmpty(successMessage))
        {
            <div class="alert" style="background:rgba(70,211,105,0.1);border:1px solid rgba(70,211,105,0.3);color:#46d369;border-radius:10px;padding:12px 16px;margin-bottom:16px;display:flex;align-items:center;gap:8px">
                <i class="fas fa-check-circle"></i>
                <span>@successMessage</span>
            </div>
        }
        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert" style="background:rgba(229,9,20,0.1);border:1px solid rgba(229,9,20,0.3);color:#ff4d4d;border-radius:10px;padding:12px 16px;margin-bottom:16px;display:flex;align-items:center;gap:8px">
                <i class="fas fa-exclamation-circle"></i>
                <span>@errorMessage</span>
            </div>
        }

        @RenderBody()
    </main>
</div>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/main.js"></script>
<script src="~/js/admin-table.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
