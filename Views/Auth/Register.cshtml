@model RegisterViewModel
@{
    ViewData["Title"] = ViewData["Title"] ?? "Đăng ký tài khoản - UTC Cinema";
    var errorMessage = ViewData["errorMessage"] as string;
}
<div class="auth-container">
    <div class="auth-card animate-fade-up" style="max-width:500px">
        <div class="auth-logo"><i class="fas fa-user-plus me-2"></i>Đăng ký</div>
        <div class="auth-subtitle">Tạo tài khoản để đặt vé dễ dàng hơn</div>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert mb-3" style="background:rgba(229,9,20,0.1);border:1px solid rgba(229,9,20,0.3);color:#ff4d4d;border-radius:10px;padding:12px 16px;font-size:0.88rem">
                <i class="fas fa-exclamation-circle me-2"></i>@errorMessage
            </div>
        }
        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert mb-3" style="background:rgba(229,9,20,0.1);border:1px solid rgba(229,9,20,0.3);color:#ff4d4d;border-radius:10px;padding:12px 16px;font-size:0.88rem">
                <div asp-validation-summary="All"></div>
            </div>
        }

        <form asp-controller="Auth" asp-action="Register" method="post" novalidate>
            @Html.AntiForgeryToken()

            <div class="mb-3">
                <label class="form-label-dark">Họ và tên *</label>
                <input type="text" asp-for="HoTen" class="form-control-dark form-control" placeholder="Nguyễn Văn A"/>
            </div>

            <div class="row g-2 mb-3">
                <div class="col-6">
                    <label class="form-label-dark">Số điện thoại *</label>
                    <input type="tel" asp-for="Sdt" class="form-control-dark form-control" placeholder="0901234567"/>
                </div>
                <div class="col-6">
                    <label class="form-label-dark">Email *</label>
                    <input type="email" asp-for="Email" class="form-control-dark form-control" placeholder="email@example.com"/>
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label-dark">Ngày sinh *</label>
                <input type="date" asp-for="NgaySinh" class="form-control-dark form-control" max="@DateTime.Today.ToString("yyyy-MM-dd")"/>
                <div style="font-size:0.75rem;color:#555;margin-top:4px">
                    <i class="fas fa-info-circle me-1"></i>Dùng để kiểm tra độ tuổi khi đặt vé phim có giới hạn độ tuổi (K, T13, T16, T18).
                </div>
            </div>

            <div class="row g-2 mb-4">
                <div class="col-6">
                    <label class="form-label-dark">Mật khẩu *</label>
                    <input type="password" asp-for="MatKhau" class="form-control-dark form-control" placeholder="Tối thiểu 6 ký tự"/>
                </div>
                <div class="col-6">
                    <label class="form-label-dark">Xác nhận MK *</label>
                    <input type="password" asp-for="XacNhanMatKhau" class="form-control-dark form-control" placeholder="Nhập lại mật khẩu"/>
                </div>
            </div>

            <button type="submit" class="btn-cinema w-100" style="padding:13px;font-size:0.95rem;justify-content:center">
                <i class="fas fa-user-plus"></i>Tạo tài khoản
            </button>
        </form>

        <div class="text-center mt-4" style="color:#666;font-size:0.88rem">
            Đã có tài khoản?
            <a href="/Auth/Login" style="color:#e50914;text-decoration:none;font-weight:600">Đăng nhập ngay</a>
        </div>
    </div>
</div>
